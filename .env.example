PORT=4000
NODE_ENV=development

# Local media root (sources, scenes, captions, exports)
CLIPPER_DATA_DIR=./.clipper-data

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Supabase (Auth + metadata only — no cloud media)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Dev: accept stub bearer tokens without verifying Supabase
AUTH_STUB=true
